#!/usr/bin/env bash
# Usage: druby [tag]   Drops into a ruby container with the cwd mounted (default tag: slim)
set -euo pipefail
exec docker run -it --rm --network host \
  --name "$(basename "$PWD")-$(date +%s)" \
  --mount "src=$PWD,target=/usr/src/myapp,type=bind" \
  -w /usr/src/myapp "ruby:${1:-slim}" bash
