# Visual
theme = "Monokai Soda"
font-family = "MesloLGS Nerd Font Mono"

# Keybindings
keybind = cmd+opt+right=next_tab
keybind = cmd+opt+left=previous_tab
# cmd+k sends ctrl+l (0x0c) instead of Ghostty's own clear_screen, so it clears
# the screen inside TUIs that never see Ghostty's action — herdr panes in
# particular, where herdr forwards the raw byte to the pane's shell.
keybind = cmd+k=text:\x0c
# Ghostty's real clear_screen (wipes scrollback too) moves to cmd+shift+k.
keybind = cmd+shift+k=clear_screen

# Behaviors
window-inherit-working-directory = false
working-directory = home
tab-inherit-working-directory = false
split-inherit-working-directory = false

# Shell Intergrations
shell-integration-features = ssh-env,ssh-terminfo

