# zmodload zsh/zprof # Uncomment me if you wanna do some profiling

# Global Path Override
export PATH=/usr/local/bin:$PATH:$HOME/bin:$HOME/scripts

# Path to your oh-my-zsh configuration.
export ZSH=$HOME/.oh-my-zsh

# Set to the name theme to load.
export ZSH_THEME="jived"

# Comment this out to disable weekly auto-update checks
export DISABLE_AUTO_UPDATE="true"

# Plugins
plugins=(
  macos
  mise
  direnv
)

# Homebrew and ~/.local/bin have to be on PATH before oh-my-zsh sources its
# plugins: the mise plugin returns early and silently when `mise` isn't found.
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
export PATH="$HOME/.local/bin:$PATH"

source $ZSH/oh-my-zsh.sh

# Path Setup
source ~/.profile

# Aliases
for dotfile in ~/dotfiles/_zsh_*; do
  source ${dotfile}
done

# Atuin owns ctrl+r. Up-arrow deliberately stays on zsh's own history, so
# --disable-up-arrow is load-bearing here, not decoration.
command -v atuin >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"

# zprof # bottom of .zshrc # Uncomment me if you wanna do some profiling

# >>> guise >>>
[ -f "$HOME/.config/guise/hook.sh" ] && . "$HOME/.config/guise/hook.sh"
# <<< guise <<<

export PATH="$HOME/agents/bin:$PATH"
