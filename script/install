#!/usr/bin/env bash
set -euo pipefail

# Dotfiles installer — safe to re-run on any machine.
# Symlinks configs into place, backs up anything real it would clobber, and
# fills in the blanks (oh-my-zsh, vim plugins, fonts) only when missing.

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OS="$(uname -s)"

echo "==> Installing dotfiles from $REPO_DIR"

# The shell fragments source paths hardcoded to ~/dotfiles, so the repo needs
# to live there for sourcing to resolve. Warn loudly if it doesn't.
if [[ "$REPO_DIR" != "$HOME/dotfiles" ]]; then
  echo ""
  echo "  WARNING: repo is at $REPO_DIR, but the shell configs source ~/dotfiles."
  echo "           Move or symlink this repo to ~/dotfiles for everything to load."
fi
echo ""

# ── Helpers ───────────────────────────────────────────────────────────────────

# link <source> <target>
#   - Skips if target is already the correct symlink
#   - Relinks if it points somewhere stale
#   - Backs up real files/dirs (timestamped) before symlinking
link() {
  local src="$1"
  local target="$2"

  mkdir -p "$(dirname "$target")"

  if [[ -L "$target" ]]; then
    local current
    current="$(readlink "$target")"
    if [[ "$current" == "$src" ]]; then
      echo "  [ok]     $target"
      return
    fi
    echo "  [relink] $target  (was -> $current)"
    rm "$target"
  elif [[ -e "$target" ]]; then
    local backup="${target}.backup.$(date +%Y%m%d%H%M%S)"
    echo "  [backup] $target -> $backup"
    mv "$target" "$backup"
  fi

  ln -s "$src" "$target"
  echo "  [linked] $target -> $src"
}

# ── Shell config ──────────────────────────────────────────────────────────────

echo "==> Shell config"
link "$REPO_DIR/zsh/zshrc" "$HOME/.zshrc"
echo ""

# ── git ───────────────────────────────────────────────────────────────────────
#
# ~/.config/git/ignore is git's default global excludes path, so no
# core.excludesfile is needed.

echo "==> git"
link "$REPO_DIR/config/git/config" "$HOME/.gitconfig"
link "$REPO_DIR/config/git/ignore" "$HOME/.config/git/ignore"
echo ""

# ── oh-my-zsh ─────────────────────────────────────────────────────────────────
#
# Installs to the default ~/.oh-my-zsh, matching ZSH=$HOME/.oh-my-zsh in zsh/zshrc.
# KEEP_ZSHRC=yes leaves our symlinked .zshrc untouched.

echo "==> oh-my-zsh"
export ZSH="$HOME/.oh-my-zsh"
if [[ -d "$ZSH" ]]; then
  echo "  [ok]     already installed at $ZSH"
else
  echo "  [install] $ZSH"
  RUNZSH=no KEEP_ZSHRC=yes CHSH=no \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

# Custom zsh themes
mkdir -p "$ZSH/custom/themes"
for theme in "$REPO_DIR"/resources/themes/zsh/*.zsh-theme; do
  [[ -e "$theme" ]] || continue
  link "$theme" "$ZSH/custom/themes/$(basename "$theme")"
done
echo ""

# ── vim ───────────────────────────────────────────────────────────────────────
#
# ~/.vimrc just does `runtime vimrc`, which loads the repo vimrc symlinked into
# ~/.vim/. Plugins are managed by vim-plug.

echo "==> vim"
if [[ "$(cat "$HOME/.vimrc" 2>/dev/null || true)" != "runtime vimrc" ]]; then
  if [[ -e "$HOME/.vimrc" && ! -L "$HOME/.vimrc" ]]; then
    backup="$HOME/.vimrc.backup.$(date +%Y%m%d%H%M%S)"
    echo "  [backup] $HOME/.vimrc -> $backup"
    mv "$HOME/.vimrc" "$backup"
  fi
  echo "runtime vimrc" > "$HOME/.vimrc"
  echo "  [write]  $HOME/.vimrc"
else
  echo "  [ok]     $HOME/.vimrc"
fi

link "$REPO_DIR/config/vim/vimrc" "$HOME/.vim/vimrc"

PLUG="$HOME/.vim/autoload/plug.vim"
if [[ -f "$PLUG" ]]; then
  echo "  [ok]     vim-plug"
else
  echo "  [fetch]  vim-plug"
  curl -fsSLo "$PLUG" --create-dirs \
    https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
fi

if command -v vim >/dev/null 2>&1; then
  echo "  [plugins] vim +PlugInstall"
  vim -es -u "$HOME/.vimrc" -c PlugInstall -c qall >/dev/null 2>&1 </dev/null || true
  # vim's exit code is unreliable here (a first run errors on the colorscheme
  # before the plugin exists), so judge by what actually landed on disk.
  want="$(grep -c "^Plug '" "$REPO_DIR/config/vim/vimrc")"
  have="$(ls "$HOME/.vim/plugged" 2>/dev/null | wc -l | tr -d ' ')"
  if [[ "$have" -ge "$want" ]]; then
    echo "  [ok]     $have plugins installed"
  else
    echo "  [warn]   only $have of $want plugins installed — run ':PlugInstall' in vim"
  fi
else
  echo "  [skip]   vim not installed — skipping plugin install"
fi
echo ""

# ── App configs (symlinked into ~/.config) ────────────────────────────────────

echo "==> App configs"
link "$REPO_DIR/config/ghostty/config"      "$HOME/.config/ghostty/config"
link "$REPO_DIR/config/cmux/settings.json"  "$HOME/.config/cmux/settings.json"
link "$REPO_DIR/config/hunk/config.toml"    "$HOME/.config/hunk/config.toml"
link "$REPO_DIR/config/herdr/config.toml"   "$HOME/.config/herdr/config.toml"
link "$REPO_DIR/config/atuin/config.toml"   "$HOME/.config/atuin/config.toml"
echo ""

# ── macOS-specific ────────────────────────────────────────────────────────────

if [[ "$OS" == "Darwin" ]]; then
  echo "==> macOS"

  if command -v brew >/dev/null 2>&1; then
    if brew list --cask font-meslo-lg-nerd-font >/dev/null 2>&1; then
      echo "  [ok]     Meslo Nerd Font"
    else
      echo "  [install] Meslo Nerd Font"
      brew install --cask font-meslo-lg-nerd-font
    fi
  else
    echo "  [skip]   Homebrew not found — skipping font install"
  fi

  # Rectangle: RectangleConfig.json is Rectangle's own export format. Turn it
  # into a plist and hand it to `defaults import`. Only seeds a fresh machine;
  # once Rectangle has prefs, its own settings UI is the source of truth.
  RECT_CONFIG="$REPO_DIR/config/rectangle/RectangleConfig.json"
  if defaults read com.knollsoft.Rectangle >/dev/null 2>&1; then
    echo "  [ok]     Rectangle prefs already present"
  elif [[ -e "$RECT_CONFIG" ]]; then
    python3 - "$RECT_CONFIG" <<'PY' | defaults import com.knollsoft.Rectangle -
import json, plistlib, sys
cfg = json.load(open(sys.argv[1]))
prefs = {k: next(iter(v.values())) for k, v in cfg["defaults"].items() if v}
prefs.update(cfg["shortcuts"])
plistlib.dump(prefs, sys.stdout.buffer)
PY
    echo "  [set]    Rectangle prefs (restart Rectangle to apply)"
  fi

  # Disable press-and-hold so key-repeat works in editors
  defaults write -g ApplePressAndHoldEnabled -bool false
  echo "  [set]    ApplePressAndHoldEnabled = false"
  echo ""
fi

echo "==> Done. Restart your shell (or 'exec zsh') to pick everything up."
